# Public entry point. With a real domain Caddy obtains and renews HTTPS certificates itself.
{$FONTIS_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# MCP server (Streamable HTTP): straight to the backend, without buffering streamed responses.
	handle /mcp* {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}
	# Answers can take up to a few minutes while a model loads.
	reverse_proxy frontend:3000 {
		transport http {
			read_timeout 180s
		}
	}
}
