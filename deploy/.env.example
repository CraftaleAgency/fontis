# Copy to .env and fill in. Never commit .env.

# Public host name; "localhost" serves a self-signed certificate for a local test.
FONTIS_DOMAIN=fontis.example.eu

POSTGRES_PASSWORD=
# First administrator, created on the first start.
FONTIS_ADMIN_EMAIL=
FONTIS_ADMIN_PASSWORD=

# Model server. Default: the "gpu" profile's Ollama on this server.
# A separate GPU machine: http://10.0.0.5:11434 ; Ollama on the host: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# Questions per client per minute (0 = no limit) and answer log retention.
FONTIS_RATE_LIMIT_PER_MINUTE=20
# Answers generated at the same time; more get "busy, try again".
FONTIS_MAX_CONCURRENT_ANSWERS=2
FONTIS_LOG_RETENTION_DAYS=30

# Tracing to Langfuse (or any OTLP/HTTP endpoint). Prompts and answers are not sent.
FONTIS_TRACING_ENABLED=false
FONTIS_OTLP_ENDPOINT=https://langfuse.example.eu/api/public/otel/v1/traces
# "Basic " + base64("<public key>:<secret key>"), e.g. printf 'pk-lf-...:sk-lf-...' | base64
FONTIS_OTLP_AUTHORIZATION=
# Send questions, sources and answers too (needed for evaluations in Langfuse). Check your data
# protection assessment first: they may contain personal data.
FONTIS_TRACING_CAPTURE_CONTENT=false
# Langfuse environment, to keep test traces apart from production.
FONTIS_ENVIRONMENT=production

# Grafana (monitoring profile).
GRAFANA_ADMIN_PASSWORD=
